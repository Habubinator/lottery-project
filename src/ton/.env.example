# TON Payment Module Configuration

# Required: Your TON wallet address for receiving payments
TON_WALLET_ADDRESS=EQDx1234567890abcdefghijklmnopqrstuvwxyz

# Optional: Network selection (mainnet or testnet)
# Default: mainnet
TON_NETWORK=mainnet

# Optional: TON API endpoint
# Default: https://toncenter.com/api/v2/jsonRPC (mainnet) or https://testnet.toncenter.com/api/v2/jsonRPC (testnet)
TON_API_ENDPOINT=https://toncenter.com/api/v2/jsonRPC

# Optional: TonCenter API key for higher rate limits
# Get your API key from: https://tonconsole.com/
TON_API_KEY=your_api_key_here

# Optional: Invoice expiration time in minutes
# Default: 30
TON_INVOICE_EXPIRATION_MINUTES=30
