  "scripts": {
    "build": "npx tsc && npx tsc-alias",
    "commit": "npx cz",
    "db:seed": "node cli/seed.js",
    "dev": "nodemon --watch \"src/\" --ext \"ts,json\" --ignore \"src//*.spec.ts\" --exec \"npx tsx src/index.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"locales/*.json\"",
    "husky:prepare": "husky",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:start": "pm2 start",
    "prune:sessions": "node cli/prune-sessions.js",
    "userbot:login:standard": "node cli/userbot-login-standard.js",
    "userbot:login:unique": "node cli/userbot-login-unique.js",
    "start": "node dist/index.js",
    "start:bot": "node dist/bot/index.js",
    "script:update-invite-links": "npx tsx src/scripts/update-channel-invite-links.ts",
    "script:backfill-sponsor-images": "npx tsx src/scripts/backfill-sponsor-link-images.ts",
    "script:fragment-stars-price": "node cli/fragment-stars-price.js",
    "script:audit-referral-tickets": "npx tsx src/scripts/audit-referral-tickets.ts",
    "script:audit-api-session": "npx tsx src/scripts/audit-api-session-giveaway.ts",
    "script:backfill-shared-managers": "npx tsx src/scripts/backfill-shared-channel-managers.ts",
    "script:refund-lottery-bug-stars": "npx tsx src/scripts/refund-lottery-bug-stars.ts",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --detectOpenHandles --forceExit",
    "test:watch": "jest --watch"
  },
