// ─── Gift prizes ─────────────────────────────────────────────────────────────

enum GiveawayPrizeStatus {
  Available // on business account, not linked to any giveaway
  Linked // assigned to a giveaway, fee may or may not be paid
  ReadyToClaim // giveaway ended, winner assigned — awaiting claim
  Processing // claim queued or in progress — prevents duplicate sends
  Cooldown // transferGift blocked by next_transfer_date, awaiting retry
  Transferred // successfully sent to winner or chosen recipient
  Failed // transfer failed permanently
}

enum GiveawayPrizeType {
  UniqueGift // NFT gift deposited to business account
  StandardGift // catalog gift bought by platform at delivery time
}

model GiveawayPrize {
  id                         Int                 @id @default(autoincrement())
  ownedGiftId                String?             @map("owned_gift_id")
  telegramGiftId             String?             @map("telegram_gift_id")
  starCount                  Int?                @map("star_count")
  prizeType                  GiveawayPrizeType   @default(UniqueGift) @map("prize_type")
  claimDeadline              DateTime?           @map("claim_deadline") @db.Timestamptz(3)
  giveawayId                 String?             @map("giveaway_id") @db.Uuid
  giveaway                   Giveaway?           @relation(fields: [giveawayId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  depositedByUserId          Int                 @map("deposited_by_user_id")
  depositedByUser            User                @relation("PrizeDepositor", fields: [depositedByUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  winnerUserId               Int?                @map("winner_user_id")
  winnerUser                 User?               @relation("PrizeWinner", fields: [winnerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  winPlace                   Int?                @map("win_place")
  giftName                   String?             @map("gift_name")
  giftNumber                 String?             @map("gift_number")
  giftNftName                String?             @map("gift_nft_name")
  giftBaseName               String?             @map("gift_base_name")
  modelName                  String?             @map("model_name")
  symbolName                 String?             @map("symbol_name")
  backdropName               String?             @map("backdrop_name")
  modelRarityPermille        Int?                @map("model_rarity_permille")
  symbolRarityPermille       Int?                @map("symbol_rarity_permille")
  backdropRarityPermille     Int?                @map("backdrop_rarity_permille")
  backdropCenterColor        Int?                @map("backdrop_center_color")
  backdropEdgeColor          Int?                @map("backdrop_edge_color")
  backdropPatternColor       Int?                @map("backdrop_pattern_color")
  backdropTextColor          Int?                @map("backdrop_text_color")
  modelStickerFileId         String?             @map("model_sticker_file_id")
  symbolStickerFileId        String?             @map("symbol_sticker_file_id")
  modelStickerPath           String?             @map("model_sticker_path")
  symbolStickerPath          String?             @map("symbol_sticker_path")
  modelStickerGifPath        String?             @map("model_sticker_gif_path")
  symbolStickerGifPath       String?             @map("symbol_sticker_gif_path")
  modelStickerGifPosterPath  String?             @map("model_sticker_gif_poster_path")
  symbolStickerGifPosterPath String?             @map("symbol_sticker_gif_poster_path")
  status                     GiveawayPrizeStatus @default(Available)
  commissionPaid             Boolean             @default(false) @map("commission_paid")
  commissionTransactionId    String?             @map("commission_transaction_id") @db.Uuid
  nextTransferDate           DateTime?           @map("next_transfer_date") @db.Timestamptz(3)
  transferredAt              DateTime?           @map("transferred_at") @db.Timestamptz(3)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants Participant[]

  @@index([giveawayId])
  @@index([depositedByUserId])
  @@index([winnerUserId])
  @@map("giveaway_prize")
}

