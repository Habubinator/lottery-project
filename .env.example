# APP
NODE_ENV=development
# Set to "true" to block new user registration (existing users are unaffected)
REGISTRATION_CLOSED=false
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:XXXX # domain1,domain2
DOMAIN=censored-link.com
CLIENT_URL=https://censored-link.com
API_URL=https://censored-link.com/api
CSRF_SECRET=secret

# POSTGRES
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/api

# JWT
JWT_ACCESS_SECRET=secret_at
JWT_REFRESH_SECRET=secret_rt
JWT_ISSUER="Example.Api"
JWT_AUDIENCE="Example.Resource"


# BOT_TOKEN
BOT_TOKEN=12345678:XXXXXXXXXXXXXX

# Telegram IDs of business accounts (auto-type detection on connection)
BUSINESS_ACCOUNT_STANDARD_ID=0000000000
BUSINESS_ACCOUNT_UNIQUE_ID=0000000000
WEB_APP_LINK=https://censored-link.com
BOT_LINK=https://t.me/example_bot

# MULTER
MULTER_DEST=root/prject_name/static

# GIFT PROVIDER вЂ” 'business' (default) or 'userbot' (requires REDIS_URL, userbot-worker PM2 process, and authenticated sessions)
GIFT_PROVIDER=business

# REDIS вЂ” required when GIFT_PROVIDER=userbot (BullMQ job queue)
REDIS_URL=redis://:yourpassword@localhost:6379
REDIS_PASSWORD=yourpassword

# Gift send throttle (userbot queue job delay; HTTP returns immediately)
GIFT_SEND_DELAY_MIN_MS=20000
GIFT_SEND_DELAY_MAX_MS=60000
GIFT_SEND_BATCH_STAGGER_MS=45000
# BullMQ gift worker parallel jobs (default 2; max 5 вЂ” shared gramjs sessions)
GIFT_WORKER_CONCURRENCY=2
# Revert Processing prizes with no active queue job after this many ms (default 15 min)
GIFT_PROCESSING_STALE_MS=900000

# TELEGRAM MTProto credentials вЂ” get from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
